# Telegram (Telethon, личный аккаунт) — my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=data/karina
MANAGER_CHAT=me

# SOCKS5-прокси (опционально, пусто = без прокси)
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# Poe (https://poe.com/api_key) — два вынесенных бота, как в Roman.
# Персона/логика/промпт настраиваются на poe.com при создании бота, код
# посылает им только данные (историю диалога + company_name/manager_name).
POE_API_KEY=
POE_CLASSIFIER_MODEL=Aliko_Classifier
POE_CHAT_MODEL=Aliko_Dialog

# Сопутствующие данные, отправляются ботам Poe как есть (не промпт)
COMPANY_NAME=Алико потолки
MANAGER_NAME=Карина

# Батчинг входящих сообщений (сек)
MESSAGE_BATCH_WAIT_SEC=7
MESSAGE_BATCH_SETTLE_SEC=1.5
MESSAGE_BATCH_TAIL_WAIT_SEC=3
MESSAGE_BATCH_MAX_WAIT_SEC=20
TYPING_IDLE_SEC=3

# 1 = тестовый режим: пиши боту сам себе в Избранное (Saved Messages),
# бот отвечает туда же с меткой 🤖. Реальным юзерам ничего не уходит.
SELF_TEST=0

# Группа, куда падает заявка (username + телефон + конспект переписки),
# как только в сообщении клиента находится телефон. Аккаунт должен уже
# состоять в этой группе.
LEADS_GROUP_CHAT_ID=

# Дожим: клиент молчит, телефон не оставил — бот напоминает о себе.
# Секунды от последнего сообщения КЛИЕНТА. Для теста можно поставить
# маленькие числа (например 20 и 40), чтобы не ждать реальные часы.
FOLLOWUP_1_DELAY_SEC=7200
FOLLOWUP_2_DELAY_SEC=86400
FOLLOWUP_POLL_SEC=300
